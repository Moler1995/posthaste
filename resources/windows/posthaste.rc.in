// Windows resource template rendered by `build.rs`.
//
// Placeholders:
//   @ICON_PATH@        absolute path to posthaste.ico, forward slashes
//   @FILE_VERSION@     four comma-separated numbers, e.g. 0,1,0,0
//   @DISPLAY_VERSION@  CARGO_PKG_VERSION verbatim

1 ICON "@ICON_PATH@"

1 VERSIONINFO
 FILEVERSION @FILE_VERSION@
 PRODUCTVERSION @FILE_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Posthaste"
            VALUE "FileDescription", "Posthaste"
            VALUE "FileVersion", "@DISPLAY_VERSION@"
            VALUE "InternalName", "posthaste"
            VALUE "OriginalFilename", "posthaste.exe"
            VALUE "ProductName", "Posthaste"
            VALUE "ProductVersion", "@DISPLAY_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
